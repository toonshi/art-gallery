# Copy to .env.local and fill in. Leave the Supabase keys empty to run on demo data.

# Public URL of the site (used for Stripe return links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Arten
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server only. Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys (use sk_test_... until launch)
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=
